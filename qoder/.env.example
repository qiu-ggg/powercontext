# Flask 配置
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# PowerContext：默认使用真实服务（必选，启动步骤见 RUNNING.md 第 3 节）
POWERCONTEXT_MODE=remote
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000

# 仅离线预览页面时才改为 local；auto 表示服务不可达时自动回退
# POWERCONTEXT_MODE=local

# 检索层使用 SQLite + FTS5，数据库文件自动创建在 data/ 目录
