+    @classmethod
+    def reject_non_strict_count_threshold(cls, value: Any) -> Any:
+        """Accept only ``None`` or a real positive ``int``.
+
+        A count threshold decides whether work starts, so an approximate value
+        is a configuration mistake: booleans, strings and floats are rejected
+        instead of being coerced into a number nobody wrote.
+        """
+
+        if value is None:
+            return None
+        if type(value) is not int:
