data: {"event":"node_finished","conversation_id":"a78acffe-9519-46db-bed1-b6812a3ff391","message_id":"ce402e2f-481b-43fa-9a74-867b357b65a3","created_at":1793605896,"task_id":"6812f748-2cf8-49a6-93ee-a95247a125d4","workflow_run_id":"5992c4a8-e969-4602-bbd8-6b3bd5470415","data":{"id":"7794c983-1733-4430-900c-08a4e32def96","node_id":"recall","node_type":"http-request","title":"召回旧账","index":5,"predecessor_node_id":null,"inputs":{},"inputs_truncated":false,"process_data":{"request":"POST /v1/memory/search HTTP/1.1\r\nHost: 127.0.0.1:8000\r\nContent-Type: application/json\r\nContent-Length: 89\r\n\r\n{\"scope_id\":\"scp_5mmd4e8nzda9hb7c38t8v8hbkm\",\"query\":\"通缉演示三 怒气\",\"limit\":50,\"mode\":\"auto\"}"},"process_data_truncated":false,"outputs":{"status_code":200,"body":"{\"memory\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"mode\":\"fts\",\"hits\":[{\"citation\":{\"memory_ref\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"entry_id\":\"mem_ent_4d4d45bac6ea410d92eb6943f220f53f\",\"entry_version_id\":\"mem_ver_0211d31caf864e49bdebdeef97b24e6d\"},\"text\":\"玩家【通缉演示三】对老周做了：把一只假蟑螂塞进老周的杯垫底下。老周的反应：老周怒瞪你一眼，把假蟑螂踢到你脚边，嘴里骂道：。怒气+3。\",\"score\":0.01639344262295082,\"matched_by\":[\"fts\"]},{\"citation\":{\"memory_ref\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"entry_id\":\"mem_ent_3890a32b8fd848bf82aa26a98d487057\",\"entry_version_id\":\"mem_ver_2726bff7643848159a114621b485a521\"},\"text\":\"玩家把招牌菜喂给黄狗，老周怒气冲冲，怒气 +4\",\"score\":0.016129032258064516,\"matched_by\":[\"fts\"]},{\"citation\":{\"memory_ref\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"entry_id\":\"mem_ent_080f95f8890f4f3fab8fc8354f841c62\",\"entry_version_id\":\"mem_ver_ca33874c50734dc9a587b14d67b55ad8\"},\"text\":\"玩家偷偷把老周的招牌酒换成兑水的假酒，老周怒气冲天，要求玩家重新酿制（怒气 +5）\",\"score\":0.015873015873015872,\"matched_by\":[\"fts\"]},{\"citation\":{\"memory_ref\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"entry_id\":\"mem_ent_a788c4bd7c5e472cb7932c7a09c293ce\",\"entry_version_id\":\"mem_ver_b1c7e9b6fa6f409c99c712304eed8133\"},\"text\":\"老周被辣得直咳嗽，记下了这次恶作剧（怒气 +3）\",\"score\":0.015625,\"matched_by\":[\"fts\"]},{\"citation\":{\"memory_ref\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"entry_id\":\"mem_ent_805ea14c8f69409eaa193f34cb6a41d0\",\"entry_version_id\":\"mem_ver_3acf5923b1bd443b8102f6c034bf8289\"},\"text\":\"玩家把糖罐和盐罐对调，让整晚的甜酒都变咸，老周怒气 +3。\",\"score\":0.015384615384615385,\"matched_by\":[\"fts\"]},{\"citation\":{\"memory_ref\":{\"family\":\"memory\",\"artifact_id\":\"memory\",\"revision\":6},\"entry_id\":\"mem_ent_8f490dd2f64447b297c9989af3678d3c\",\"entry_version_id\":\"mem_ver_c340be5b51ae425b8102ed4630a4699e\"},\"text\":\"玩家锯短了老周常坐的藤椅一条腿，老周把小桌掀翻，怒气 +5。\",\"score\":0.015151515151515152,\"matched_by\":[\"fts\"]}]}","headers":{"connection":"close","content-length":"2240","content-type":"application/json","date":"Mon, 02 Nov 2026 15:51:35 GMT","server":"uvicorn","x-powercontext-request-id":"df0fc760d55e718f"},"files":[]},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.042607,"execution_metadata":null,"created_at":1793605895,"finished_at":1793605896,"files":[],"iteration_id":null,"loop_id":null}}

