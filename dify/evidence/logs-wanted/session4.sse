data: {"event":"node_finished","conversation_id":"ab7c8dfa-20a0-4938-af56-b62229e7de22","message_id":"fe14ee28-7403-46d0-91da-8a1315235063","created_at":1793605889,"task_id":"9859f85b-9a57-4ddf-8c48-586c44cba530","workflow_run_id":"9eb02e6c-552c-4b28-8bc9-ddbdf3e5a9db","data":{"id":"0e53a5f5-1d6f-41d7-b20c-ae9c9ac75a20","node_id":"kb","node_type":"knowledge-retrieval","title":"检索恶作剧图鉴","index":7,"predecessor_node_id":null,"inputs":{"query":"把老周的招牌菜端去喂门口的黄狗"},"inputs_truncated":false,"process_data":{"usage":{"prompt_tokens":0,"prompt_unit_price":"0.0","prompt_price_unit":"0.0","prompt_price":"0.0","completion_tokens":0,"completion_unit_price":"0.0","completion_price_unit":"0.0","completion_price":"0.0","total_tokens":0,"total_price":"0.0","currency":"USD","latency":0.0,"time_to_first_token":null,"time_to_generate":null}},"process_data_truncated":false,"outputs":{"result":[{"metadata":{"_source":"knowledge","dataset_id":"08e2abca-e168-42ee-9cf1-85036e3066e9","dataset_name":"记仇酒馆·恶作剧图鉴","document_id":"da8a49c0-7b4a-4bf3-9786-1f21cee9e875","document_name":"prank_compendium.md","data_source_type":"upload_file","segment_id":"51a70d86-95bc-42d1-b7ae-ab4653c6ae73","retriever_from":"workflow","score":0.5112073981195542,"child_chunks":[],"segment_hit_count":16,"segment_word_count":161,"segment_position":7,"segment_index_node_hash":"d6c65ece495142d804d1b649ab8b02d535dd4ed5802f7820cb1dcaf6da5bad9b","doc_metadata":null,"position":1},"title":"prank_compendium.md","files":null,"content":"换掉招牌酒\n- 招式名：招牌酒掉包\n- 操作方式：把吧台后那瓶招牌陈酿换成颜色相近的廉价酒。\n- 预期效果：老周给熟客倒酒时被当场拆穿，面子上挂不住。\n- 老周的反应：先给客人赔笑换酒，转头把空瓶子摆在你面前当证据。\n- 反制手段：你的酒从此由他亲手从地窖取，当着你的面开瓶。\n- 危险度：★★★（砸招牌，老周最恨这一招）","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"08e2abca-e168-42ee-9cf1-85036e3066e9","dataset_name":"记仇酒馆·恶作剧图鉴","document_id":"da8a49c0-7b4a-4bf3-9786-1f21cee9e875","document_name":"prank_compendium.md","data_source_type":"upload_file","segment_id":"6f581b0b-5fb5-4955-80e5-ddd030eded75","retriever_from":"workflow","score":0.5058955570166697,"child_chunks":[],"segment_hit_count":42,"segment_word_count":160,"segment_position":4,"segment_index_node_hash":"393d8e83e8adadae926b7cb0aed541c67b5b8719971ddf9d1953b153d2db3c03","doc_metadata":null,"position":2},"title":"prank_compendium.md","files":null,"content":"盐当糖\n- 招式名：盐罐换糖罐\n- 操作方式：把老周做甜酒用的糖罐和盐罐对调。\n- 预期效果：整晚的甜酒都变成咸的，老周自己尝了一口后表情扭曲。\n- 老周的反应：沉默三秒，然后把那壶咸酒原价卖给你，说“不能浪费”。\n- 反制手段：从此糖罐上贴着你的名字，专供你一个人。\n- 危险度：★★☆（破坏一整晚的生意，账记得很牢）","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"08e2abca-e168-42ee-9cf1-85036e3066e9","dataset_name":"记仇酒馆·恶作剧图鉴","document_id":"da8a49c0-7b4a-4bf3-9786-1f21cee9e875","document_name":"prank_compendium.md","data_source_type":"upload_file","segment_id":"3e364e18-df31-4f7f-8176-e3e14deaac73","retriever_from":"workflow","score":0.5057850444886894,"child_chunks":[],"segment_hit_count":4,"segment_word_count":176,"segment_position":5,"segment_index_node_hash":"51aa7b1de7dd3739425738ffbe17279c61c0bd8e865b5d5025341b5feeb7d194","doc_metadata":null,"position":3},"title":"prank_compendium.md","files":null,"content":"锯短椅腿\n- 招式名：锯短一条椅腿\n- 操作方式：趁打烊前把老周常坐的藤椅一条腿锯短两厘米。\n- 预期效果：老周一屁股坐下去重心不稳，连人带椅翻倒。\n- 老周的反应：躺在地上先笑，笑完爬起来把椅子腿钉回去，还在椅背上刻了你的名字。\n- 反制手段：那把椅子成了“仇人专座”，坐上去会晃，酒也给你倒得特别满。\n- 危险度：★★★（容易摔伤，老周会真的生气）","summary":null}]},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.073036,"execution_metadata":{"total_tokens":0,"total_price":"0.0","currency":"USD"},"created_at":1793605889,"finished_at":1793605889,"files":[],"iteration_id":null,"loop_id":null}}

