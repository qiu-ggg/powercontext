_from":"workflow","score":0.5090560643360866,"child_chunks":[],"segment_hit_count":34,"segment_word_count":166,"segment_position":6,"segment_index_node_hash":"7976c0c6f6f32b9cf80253849a061ae544741c521dc7776b66c217c1c442c6f3","doc_metadata":null,"position":2},"title":"prank_compendium.md","files":null,"content":"胶水杯底\n- 招式名：胶水粘杯底\n- 操作方式：在老周常用的玻璃杯底涂一层强力胶，粘在吧台上。\n- 预期效果：老周端杯子时端不动，用力一扯把杯子扯碎。\n- 老周的反应：盯着杯底看半天，认出是你干的，默默换了个不锈钢杯。\n- 反制手段：之后给你上的酒一律用缺口的旧杯子，说是“配套”。\n- 危险度：★★★（可能割伤手，属于重点记仇项）","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"08e2abca-e168-42ee-9cf1-85036e3066e9","dataset_name":"记仇酒馆·恶作剧图鉴","document_id":"da8a49c0-7b4a-4bf3-9786-1f21cee9e875","document_name":"prank_compendium.md","data_source_type":"upload_file","segment_id":"51a70d86-95bc-42d1-b7ae-ab4653c6ae73","retriever_from":"workflow","score":0.5060930637872593,"child_chunks":[],"segment_hit_count":17,"segment_word_count":161,"segment_position":7,"segment_index_node_hash":"d6c65ece495142d804d1b649ab8b02d535dd4ed5802f7820cb1dcaf6da5bad9b","doc_metadata":null,"position":3},"title":"prank_compendium.md","files":null,"content":"换掉招牌酒\n- 招式名：招牌酒掉包\n- 操作方式：把吧台后那瓶招牌陈酿换成颜色相近的廉价酒。\n- 预期效果：老周给熟客倒酒时被当场拆穿，面子上挂不住。\n- 老周的反应：先给客人赔笑换酒，转头把空瓶子摆在你面前当证据。\n- 反制手段：你的酒从此由他亲手从地窖取，当着你的面开瓶。\n- 危险度：★★★（砸招牌，老周最恨这一招）","summary":null}]},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.242276,"execution_metadata":{"total_tokens":0,"total_price":"0.0","currency":"USD"},"created_at":1793605891,"finished_at":1793605891,"files":[],"iteration_id":null,"loop_id":null}}

